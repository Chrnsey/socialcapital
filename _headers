# Cloudflare Pages headers. Mirrors what netlify.toml did.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/admin/*
  X-Robots-Tag: noindex

# Cloudflare ignores Cache-Control here for static files - it serves css and
# js with its own four-hour browser cache no matter what this says. These two
# rules are left in place in case that ever changes, but they are NOT what
# keeps the stylesheet current.
#
# What actually does that: build.mjs puts ?v=<hash of the file> on every
# stylesheet and script reference, so a changed file is a new URL and the
# four-hour cache cannot serve the old one. See the fourth job in build.mjs.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate
